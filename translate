#!/usr/bin/env python3
"""
Subtitle translator using Meta's NLLB-200 distilled 600M.

Features
────────
• Lists .srt files for selection
• Detects source language from filename (.pt.srt, .es.srt, ...)
• Prints detected source language
• Asks for destination language (2-letter, e.g., en, fr, de)
• Translates text only (preserves SRT timing & numbering)
• GPU acceleration if available (float16)
• Progress and total time
• Output is always filename.<dest>.srt  (e.g., movie.en.srt)
"""

import os
import re
import time
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# 2-letter → NLLB language code map
NLLB_MAP = {
    "af":"afr_Latn","am":"amh_Ethi","ar":"arb_Arab","az":"azj_Latn","be":"bel_Cyrl","bg":"bul_Cyrl",
    "bn":"ben_Beng","bs":"bos_Latn","ca":"cat_Latn","cs":"ces_Latn","cy":"cym_Latn","da":"dan_Latn",
    "de":"deu_Latn","el":"ell_Grek","en":"eng_Latn","es":"spa_Latn","et":"est_Latn","eu":"eus_Latn",
    "fa":"pes_Arab","fi":"fin_Latn","fr":"fra_Latn","gl":"glg_Latn","gu":"guj_Gujr","he":"heb_Hebr",
    "hi":"hin_Deva","hr":"hrv_Latn","hu":"hun_Latn","hy":"hye_Armn","id":"ind_Latn","is":"isl_Latn",
    "it":"ita_Latn","ja":"jpn_Jpan","jv":"jav_Latn","ka":"kat_Geor","kk":"kaz_Cyrl","km":"khm_Khmr",
    "kn":"kan_Knda","ko":"kor_Hang","lo":"lao_Laoo","lt":"lit_Latn","lv":"lvs_Latn","mk":"mkd_Cyrl",
    "ml":"mal_Mlym","mn":"khk_Cyrl","mr":"mar_Deva","ms":"zsm_Latn","my":"mya_Mymr","nl":"nld_Latn",
    "no":"nob_Latn","or":"ory_Orya","pa":"pan_Guru","pl":"pol_Latn","ps":"pbt_Arab","pt":"por_Latn",
    "ro":"ron_Latn","ru":"rus_Cyrl","sd":"snd_Arab","si":"sin_Sinh","sk":"slk_Latn","sl":"slv_Latn",
    "so":"som_Latn","sq":"als_Latn","sr":"srp_Cyrl","sv":"swe_Latn","sw":"swh_Latn","ta":"tam_Taml",
    "te":"tel_Telu","th":"tha_Thai","tl":"tgl_Latn","tr":"tur_Latn","uk":"ukr_Cyrl","ur":"urd_Arab",
    "uz":"uzn_Latn","vi":"vie_Latn","yo":"yor_Latn","zh":"zho_Hans","zh-tw":"zho_Hant","zu":"zul_Latn",
}

def to_nllb(code: str) -> str:
    code = code.strip().lower()
    if code in NLLB_MAP:
        return NLLB_MAP[code]
    # if user already entered an NLLB code, pass it through
    return code

def list_srt_files():
    files = [f for f in sorted(os.listdir()) if f.lower().endswith(".srt")]
    for i, f in enumerate(files, 1): print(f"{i}: {f}")
    return files

def get_user_selection(files):
    sel = input("Enter numbers of files to translate (comma-separated), or press Enter for all: ").strip()
    if not sel: return files
    idxs = [int(i)-1 for i in sel.split(",") if i.strip().isdigit() and 0 < int(i) <= len(files)]
    return [files[i] for i in idxs]

def detect_short_lang_from_filename(filename):
    # Find all .xx or .xx-yy before .srt, pick the first one
    matches = re.findall(r"\.([a-z]{2}(?:-[a-z]{2})?)", filename.lower())
    return matches[0] if matches else None

def strip_lang_suffix_from_base(base):
    # drop trailing ".xx" or ".xx-yy" from the base name
    return re.sub(r"\.(?:[a-z]{2}(?:-[a-z]{2})?)$", "", base, flags=re.I)

def strip_all_lang_suffixes(base):
    # Remove all trailing .xx or .xx-yy groups
    return re.sub(r'(\.[a-z]{2}(-[a-z]{2})?)+$', '', base, flags=re.I)

def translate_batch_nllb(texts, tokenizer, model, src_nllb, tgt_nllb, device):
    tokenizer.src_lang = src_nllb
    inputs = tokenizer(texts, return_tensors="pt", padding=True, truncation=True).to(device)

    # Try the universal way — use the tokenizer to get the BOS token ID directly
    try:
        forced_bos_token_id = tokenizer.convert_tokens_to_ids(tgt_nllb)
        if forced_bos_token_id is None or forced_bos_token_id == tokenizer.unk_token_id:
            raise ValueError
    except Exception:
        raise ValueError(f"❌ Could not resolve BOS token for '{tgt_nllb}' via tokenizer.convert_tokens_to_ids()")

    outputs = model.generate(
        **inputs,
        forced_bos_token_id=forced_bos_token_id,
        max_length=256,
        num_beams=4,
        no_repeat_ngram_size=3
    )

    return [tokenizer.decode(o, skip_special_tokens=True) for o in outputs]

def translate_srt(file_path, src_short, tgt_short, tokenizer, model, device):
    start = time.time()
    base, _ = os.path.splitext(file_path)
    # ensure output is filename.<dest>.srt (strip existing source suffix if present)
    base_no_lang = strip_all_lang_suffixes(base)
    out_path = f"{base_no_lang}.{tgt_short}.srt"

    with open(file_path, "r", encoding="utf-8") as f:
        content = f.read().strip()

    blocks = re.split(r"\n\n+", content)
    texts, metas = [], []
    for block in blocks:
        parts = block.strip().splitlines()
        if len(parts) < 3:  # malformed block
            continue
        idx, timing, text = parts[0], parts[1], " ".join(parts[2:])
        metas.append((idx, timing))
        texts.append(text)

    src_nllb = to_nllb(src_short)
    tgt_nllb = to_nllb(tgt_short)

    print(f"🌍 Translating from {src_short.upper()} ({src_nllb}) → {tgt_short.upper()} ({tgt_nllb})  [{len(texts)} lines]")

    batch_size = 16
    out_texts = []
    for i in range(0, len(texts), batch_size):
        batch = texts[i:i+batch_size]
        out_texts.extend(translate_batch_nllb(batch, tokenizer, model, src_nllb, tgt_nllb, device))
        pct = int((i+len(batch))/max(1,len(texts))*100)
        print(f"⏳ {pct}% complete...", end="\r")

    out_blocks = []
    for (idx, timing), t in zip(metas, out_texts):
        out_blocks.append(f"{idx}\n{timing}\n{t.strip()}")

    with open(out_path, "w", encoding="utf-8") as f:
        f.write("\n\n".join(out_blocks))

    print(f"\n✅ Saved translated subtitles to: {out_path}")
    print(f"⏱ Translation completed in {time.time()-start:.1f}s\n")

def main():
    files = list_srt_files()
    if not files:
        print("No .srt files found.")
        return
    selected = get_user_selection(files)

    model_name = "facebook/nllb-200-distilled-600M"
    device = "cuda" if torch.cuda.is_available() else "cpu"
    dtype = torch.float16 if device == "cuda" else torch.float32
    print(f"\n🔁 Loading translation model: {model_name} on {device.upper()}...")
    tokenizer = AutoTokenizer.from_pretrained(model_name)
    model = AutoModelForSeq2SeqLM.from_pretrained(model_name, dtype=dtype).to(device)

    for path in selected:
        print(f"\n🎬 Processing: {path}")
        src_short = detect_short_lang_from_filename(path)
        if src_short:
            print(f"🌍 Detected source (from filename): {src_short.upper()}")
        else:
            src_short = input("Enter source language (2-letter, e.g., pt, en, es): ").strip().lower() or "en"
        tgt_short = input("Enter destination language (2-letter, e.g., en, fr, de): ").strip().lower() or "en"

        if src_short == tgt_short:
            print("⚠️  Source and destination are the same. Skipping.")
            continue

        translate_srt(path, src_short, tgt_short, tokenizer, model, device)

if __name__ == "__main__":
    main()
