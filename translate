#!/usr/bin/env python3
"""
Universal subtitle translator using OPUS-MT (EN→PT only) or NLLB-200 1.3B.

Enhancements:
──────────────
• Only asks once for destination language and model per source language
• Caches selections for full-season batches
• EN→PT offers OPUS-MT (EU Portuguese) or NLLB-1.3B
• All other pairs use NLLB-1.3B
"""

import os
import re
import time
import torch
from transformers import (
    AutoTokenizer,
    AutoModelForSeq2SeqLM,
    MarianMTModel,
    MarianTokenizer,
)

# ---------- Helpers ----------

def list_srt_files():
    files = [f for f in sorted(os.listdir()) if f.lower().endswith(".srt")]
    for i, f in enumerate(files, 1):
        print(f"{i}: {f}")
    return files


def get_user_selection(files):
    sel = input("Enter numbers of files to translate (comma-separated), or press Enter for all: ").strip()
    if not sel:
        return files
    idxs = [int(i) - 1 for i in sel.split(",") if i.strip().isdigit() and 0 < int(i) <= len(files)]
    return [files[i] for i in idxs]


def detect_lang_from_filename(filename):
    match = re.findall(r"\.([a-z]{2})(?:-[a-z]{2})?\.srt$", filename.lower())
    return match[0] if match else None


def strip_all_lang_suffixes(base):
    return re.sub(r'(\.[a-z]{2}(-[a-z]{2})?)+$', '', base, flags=re.I)


def translate_batch(texts, tokenizer, model, device, is_marian=False):
    inputs = tokenizer(texts, return_tensors="pt", padding=True, truncation=True, max_length=256).to(device)
    forced_bos_token_id = None
    if not is_marian and hasattr(tokenizer, "tgt_lang"):
        forced_bos_token_id = tokenizer.convert_tokens_to_ids(tokenizer.tgt_lang)
    outputs = model.generate(
        **inputs,
        forced_bos_token_id=forced_bos_token_id,
        num_beams=4,
        max_length=256,
        no_repeat_ngram_size=3
    )
    return [tokenizer.decode(o, skip_special_tokens=True) for o in outputs]


def translate_srt(file_path, tokenizer, model, device, src_short, tgt_short, is_marian, model_name):
    start = time.time()
    base, _ = os.path.splitext(file_path)
    base_no_lang = strip_all_lang_suffixes(base)
    out_path = f"{base_no_lang}.{tgt_short}.srt"

    with open(file_path, "r", encoding="utf-8") as f:
        content = f.read().strip()

    blocks = re.split(r"\n\n+", content)
    texts, metas = [], []
    for block in blocks:
        parts = block.strip().splitlines()
        if len(parts) < 3:
            continue
        idx, timing, text = parts[0], parts[1], " ".join(parts[2:])
        metas.append((idx, timing))
        texts.append(text)

    print(f"🌍 Using {model_name}  [{len(texts)} lines]")

    batch_size = 16
    out_texts = []
    for i in range(0, len(texts), batch_size):
        batch = texts[i:i+batch_size]
        out_texts.extend(translate_batch(batch, tokenizer, model, device, is_marian))
        pct = int((i + len(batch)) / max(1, len(texts)) * 100)
        print(f"⏳ {pct}% complete...", end="\r")

    out_blocks = []
    for (idx, timing), t in zip(metas, out_texts):
        out_blocks.append(f"{idx}\n{timing}\n{t.strip()}")

    with open(out_path, "w", encoding="utf-8") as f:
        f.write("\n\n".join(out_blocks))

    elapsed = time.time() - start
    print(f"\n✅ Saved translated subtitles to: {out_path}")
    print(f"⏱ Translation completed in {elapsed:.1f}s\n")


# ---------- Main ----------

def main():
    files = list_srt_files()
    if not files:
        print("No .srt files found.")
        return

    selected = get_user_selection(files)
    device = "cuda" if torch.cuda.is_available() else "cpu"
    print(f"\n💻 Using device: {device.upper()}")

    # Remember previous selection per source language
    previous_settings = {}

    for path in selected:
        print(f"\n🎬 Processing: {path}")

        src_short = detect_lang_from_filename(path)
        if src_short:
            print(f"🌍 Detected source: {src_short.upper()}")
        else:
            src_short = input("Enter source language (2-letter, e.g., en, pt, es): ").strip().lower() or "en"

        # Check if we already have a cached setting
        if src_short in previous_settings:
            tgt_short, is_marian, model_name, tokenizer, model = previous_settings[src_short]
            print(f"🔁 Reusing previous settings for {src_short.upper()} → {tgt_short.upper()} ({model_name})")
        else:
            tgt_short = input("Enter destination language (2-letter, e.g., en, pt, fr): ").strip().lower() or "en"

            if src_short == tgt_short:
                print("⚠️  Source and destination are the same. Skipping.")
                continue

            # ---------- Model selection ----------
            is_marian = False
            model_name = "facebook/nllb-200-1.3B"

            if (src_short, tgt_short) == ("en", "pt"):
                print("\nChoose translation engine:")
                print("1) OPUS-MT (European Portuguese, smaller, faster)")
                print("2) NLLB-200 1.3B (larger, more general multilingual)")
                choice = input("Enter number [1]: ").strip() or "1"
                if choice == "1":
                    model_name = "Helsinki-NLP/opus-mt-tc-big-en-pt"
                    is_marian = True

            print(f"\n🔁 Loading model: {model_name}")

            if is_marian:
                tokenizer = MarianTokenizer.from_pretrained(model_name)
                model = MarianMTModel.from_pretrained(model_name).to(device)
            else:
                tokenizer = AutoTokenizer.from_pretrained(model_name)
                model = AutoModelForSeq2SeqLM.from_pretrained(
                    model_name,
                    dtype=torch.float16 if device == "cuda" else torch.float32
                ).to(device)

                # --- Full NLLB language code map ---
                NLLB_MAP = {
                    "af":"afr_Latn","am":"amh_Ethi","ar":"arb_Arab","az":"azj_Latn","be":"bel_Cyrl","bg":"bul_Cyrl",
                    "bn":"ben_Beng","bs":"bos_Latn","ca":"cat_Latn","cs":"ces_Latn","cy":"cym_Latn","da":"dan_Latn",
                    "de":"deu_Latn","el":"ell_Grek","en":"eng_Latn","es":"spa_Latn","et":"est_Latn","eu":"eus_Latn",
                    "fa":"pes_Arab","fi":"fin_Latn","fr":"fra_Latn","gl":"glg_Latn","gu":"guj_Gujr","he":"heb_Hebr",
                    "hi":"hin_Deva","hr":"hrv_Latn","hu":"hun_Latn","hy":"hye_Armn","id":"ind_Latn","is":"isl_Latn",
                    "it":"ita_Latn","ja":"jpn_Jpan","jv":"jav_Latn","ka":"kat_Geor","kk":"kaz_Cyrl","km":"khm_Khmr",
                    "kn":"kan_Knda","ko":"kor_Hang","lo":"lao_Laoo","lt":"lit_Latn","lv":"lvs_Latn","mk":"mkd_Cyrl",
                    "ml":"mal_Mlym","mn":"khk_Cyrl","mr":"mar_Deva","ms":"zsm_Latn","my":"mya_Mymr","nl":"nld_Latn",
                    "no":"nob_Latn","or":"ory_Orya","pa":"pan_Guru","pl":"pol_Latn","ps":"pbt_Arab","pt":"por_Latn",
                    "ro":"ron_Latn","ru":"rus_Cyrl","sd":"snd_Arab","si":"sin_Sinh","sk":"slk_Latn","sl":"slv_Latn",
                    "so":"som_Latn","sq":"als_Latn","sr":"srp_Cyrl","sv":"swe_Latn","sw":"swh_Latn","ta":"tam_Taml",
                    "te":"tel_Telu","th":"tha_Thai","tl":"tgl_Latn","tr":"tur_Latn","uk":"ukr_Cyrl","ur":"urd_Arab",
                    "uz":"uzn_Latn","vi":"vie_Latn","yo":"yor_Latn","zh":"zho_Hans","zh-tw":"zho_Hant","zu":"zul_Latn",
                }

                def to_nllb(code: str) -> str:
                    code = code.strip().lower()
                    return NLLB_MAP.get(code, f"{code}_Latn")

                tokenizer.src_lang = to_nllb(src_short)
                tokenizer.tgt_lang = to_nllb(tgt_short)
                print(f"🌐 NLLB direction: {tokenizer.src_lang} → {tokenizer.tgt_lang}")

            # Cache for later reuse
            previous_settings[src_short] = (tgt_short, is_marian, model_name, tokenizer, model)

        translate_srt(path, tokenizer, model, device, src_short, tgt_short, is_marian, model_name)


if __name__ == "__main__":
    main()
